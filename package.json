{
  "name": "fenzy-mock-gateway",
  "version": "1.0.1",
  "private": true,
  "description": "Mock SMS, Email and Payment gateway server (Razorpay, Stripe, Cashfree, PhonePe, Twilio, MSG91, SendGrid, Resend, SES, SMTP) for testing Fenzy",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:ui": "node --disable-warning=ExperimentalWarning --test test/ui/smoke.mjs",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mailparser": "^3.14.3",
    "smtp-server": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemailer": "^10.2.1",
    "playwright-core": "^1.64.1",
    "upipay": "^1.0.0"
  }
}
