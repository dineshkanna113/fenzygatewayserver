# ---------------------------------------------------------------
# Fenzy Mock Gateway - copy to .env and edit
# ---------------------------------------------------------------

# Public URL the server is reachable at (used in checkout links, SDK scripts, webhooks docs).
# Put the mock behind HTTPS in prod, e.g. https://mock-gateway.fenzy.example
PUBLIC_URL=http://localhost:4000
# Domain served by Caddy in docker-compose.prod.yml (DNS A record must point at the VM)
DOMAIN=
MERCHANT_NAME=Fenzy

# Dashboard + admin API (/dashboard, /api/*). ALWAYS set a strong password in prod.
ADMIN_USERNAME=admin
# Production refuses to start unless this is set to 12+ characters and changed from the example
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Bearer token for automated test suites calling /api/* (optional)
ADMIN_API_TOKEN=
# Signs dashboard session cookies. Optional: a random secret is generated and stored in /data if unset.
SESSION_SECRET=

# Number of reverse proxies in front (1 behind nginx/Caddy/ALB); or "true", or CIDR list
TRUST_PROXY=1
RETENTION_DAYS=7
RATE_LIMIT_PER_MINUTE=1200
LOG_LEVEL=info

# SMTP capture server. If both are set, clients must authenticate with them.
SMTP_ENABLED=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Webhook delivery
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=10000

# ---------- Payment gateways (fake credentials your app uses in test) ----------
RAZORPAY_KEY_ID=rzp_test_mockkey000001
RAZORPAY_KEY_SECRET=mock_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=mock_razorpay_webhook_secret
RAZORPAY_WEBHOOK_URL=
RAZORPAY_AUTO_CAPTURE=true

STRIPE_SECRET_KEY=sk_test_mock_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
STRIPE_WEBHOOK_URL=

CASHFREE_APP_ID=TEST_mock_cashfree_app_id
CASHFREE_SECRET_KEY=cfsk_ma_test_mock_cashfree_secret
CASHFREE_WEBHOOK_URL=

PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=mock-phonepe-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_CLIENT_ID=MOCK_PHONEPE_CLIENT
PHONEPE_CLIENT_SECRET=mock_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=phonepe_webhook_user
PHONEPE_WEBHOOK_PASSWORD=phonepe_webhook_pass
PHONEPE_WEBHOOK_URL=

PAYTM_MERCHANT_ID=MOCKPAYTM00000000001
# 16+ characters: the first 16 are the AES-128 key for Paytm checksums
PAYTM_MERCHANT_KEY=mockpaytmkey0001
PAYTM_WEBSITE=WEBSTAGING
PAYTM_WEBHOOK_URL=

GENERIC_API_KEY=mock_generic_api_key
GENERIC_API_SECRET=mock_generic_api_secret
GENERIC_WEBHOOK_SECRET=mock_generic_webhook_secret
GENERIC_WEBHOOK_URL=

# ---------- SMS ----------
TWILIO_ACCOUNT_SID=ACmock00000000000000000000000000
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_DEFAULT_FROM=+15005550006

MSG91_AUTH_KEY=mock_msg91_authkey
MSG91_SENDER_ID=FENZY
MSG91_DLR_URL=
# Optional: render MSG91 flow templates, ##var## placeholders
# MSG91_TEMPLATES={"6512abc":"Your Fenzy OTP is ##otp##"}

# ---------- Email ----------
SENDGRID_API_KEY=SG.mock_sendgrid_api_key
RESEND_API_KEY=re_mock_resend_api_key
# If set, SES requests must be signed with this access key id (signature itself is not verified)
SES_ACCESS_KEY_ID=
